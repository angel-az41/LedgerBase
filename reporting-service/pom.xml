<?xml version="1.0" encoding="UTF-8"?>

<!--
    ============================================================
    LEDGERBASE — FINANCIAL REPORTING SERVICE
    ============================================================

    Independent Spring Boot application for financial
    reporting workloads.

    CURRENT RESPONSIBILITIES:

    - Run independently from Accounting Core.
    - Expose secured Trial Balance reporting APIs.
    - Query the PostgreSQL read replica through MyBatis.
    - Validate JWT access tokens.
    - Verify active sessions and business authorization
      through Accounting Core.
    - Connect to the local Redis Cluster.

    PLANNED RESPONSIBILITIES:

    - Cache financial reports in Redis.
    - Coordinate cache invalidation with accounting writes.
    - Extend financial reporting service extraction.

    Financial transaction posting and accounting writes
    remain inside Accounting Core.
-->

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ====================================================== -->
    <!-- SPRING BOOT PARENT -->
    <!-- ====================================================== -->

    <!-- Keep the same version as Accounting Core. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <!-- ====================================================== -->
    <!-- PROJECT IDENTITY -->
    <!-- ====================================================== -->

    <groupId>com.ledgerbase</groupId>
    <artifactId>reporting-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>LedgerBase Reporting Service</name>

    <description>
        Independent financial reporting microservice
    </description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>

        <!-- ================================================== -->
        <!-- SPRING WEB MVC -->
        <!-- ================================================== -->

        <!--
            Spring Web MVC exposes REST endpoints for
            financial reporting requests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- ================================================== -->
        <!-- ACTUATOR MONITORING -->
        <!-- ================================================== -->

        <!--
            Exposes health and service information.

            Redis health participation will initially be
            disabled so Redis outages do not incorrectly
            mark the database-backed service unhealthy.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ================================================== -->
        <!-- SPRING WEB MVC TESTING -->
        <!-- ================================================== -->

        <!--
            Supports existing Spring Boot integration
            tests and JUnit-based test execution.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ================================================== -->
        <!-- POSTGRESQL READ-ONLY DATA ACCESS -->
        <!-- ================================================== -->

        <!--
            Provides datasource configuration, HikariCP
            connection pooling, JDBC support, and
            read-only database transactions.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
            PostgreSQL JDBC driver.

            Reporting Service connects to the PostgreSQL
            standby using the restricted reader role.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ================================================== -->
        <!-- MYBATIS — FINANCIAL REPORTING SQL -->
        <!-- ================================================== -->

        <!--
            Maps PostgreSQL financial reporting queries
            to Java model and service classes.

            Preserve the version already used by LedgerBase.
        -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>4.0.1</version>
        </dependency>

        <!-- ================================================== -->
        <!-- SECURITY — JWT AND BUSINESS AUTHORIZATION -->
        <!-- ================================================== -->

        <!--
            Validates JWT Bearer access tokens using
            Spring Security OAuth2 Resource Server.

            Active session and business membership
            authorization remain authoritative in
            Accounting Core.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ================================================== -->
        <!-- REDIS CLUSTER — DISTRIBUTED CACHING -->
        <!-- ================================================== -->

        <!--
            Spring Data Redis provides:

            - RedisConnectionFactory
            - StringRedisTemplate
            - RedisTemplate
            - Redis Cluster connection support
            - Lettuce client integration

            Lettuce is the default Redis driver.

            Dependency versions are managed by the
            Spring Boot parent.

            Redis is not yet used for financial reports.
            This checkpoint establishes connectivity only.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

    </dependencies>

    <!-- ====================================================== -->
    <!-- BUILD CONFIGURATION -->
    <!-- ====================================================== -->

    <build>
        <plugins>

            <!--
                Build and run Reporting Service as an
                independent Spring Boot application.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
