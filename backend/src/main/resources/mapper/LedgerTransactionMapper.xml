<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    ============================================================
    LEDGERBASE — TRANSACTION MYBATIS MAPPER
    ============================================================

    This file implements the database operations declared in
    LedgerTransactionMapper.java.

    Main database tables:

    1. transactions
       Stores financial transaction headers.

    2. transaction_journal_numbers
       Stores company-specific journal sequence numbers.

    Example:

    transactions.id = 2
    transactions.business_id = 2
    transaction_journal_numbers.journal_number = 1

    Java calculates the displayed reference as JE-0001.

    IMPORTANT:

    - Preserve existing global transaction IDs.
    - Keep every transaction query business-scoped.
    - Preserve DRAFT-to-POSTED validation.
    - Preserve PostgreSQL row locks during posting.
-->

<mapper namespace="com.ledgerbase.backend.mapper.LedgerTransactionMapper">

    <!-- ========================================================
         1. TRANSACTION RESULT MAPPING
         ======================================================== -->

    <!--
        Map PostgreSQL columns to Java model properties.

        Standard mappings:

        business_id      -> businessId
        transaction_date -> transactionDate
        created_at       -> createdAt

        New mapping:

        journal_number   -> journalNumber

        journalReference does not need a database column.
        LedgerTransaction.getJournalReference() calculates
        the formatted value from journalNumber.
    -->

    <resultMap id="LedgerTransactionResultMap"
               type="com.ledgerbase.backend.model.LedgerTransaction">

        <id property="id" column="id"/>

        <result property="businessId" column="business_id"/>

        <!-- Company-specific journal sequence number. -->
        <result property="journalNumber" column="journal_number"/>

        <result property="createdBy" column="created_by"/>

        <result property="categoryId" column="category_id"/>
        <result property="customerId" column="customer_id"/>
        <result property="vendorId" column="vendor_id"/>

        <result property="description" column="description"/>
        <result property="transactionDate" column="transaction_date"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>

    </resultMap>


    <!-- ========================================================
         2. INSERT A NEW DRAFT TRANSACTION
         ======================================================== -->

    <!--
        Insert a new financial transaction.

        PostgreSQL generates the internal transaction ID.

        MyBatis stores that generated ID in transaction.id.

        We explicitly set status to DRAFT because the
        transaction has not yet been posted.

        BUSINESS-SPECIFIC NUMBERING:

        Flyway V8 introduced the PostgreSQL trigger:

        trg_assign_transaction_journal_number

        After this INSERT, PostgreSQL automatically creates
        the corresponding journal-number mapping.

        Therefore, we do not manually allocate journal numbers
        inside Java or this SQL statement.

        The INSERT remains unchanged.
    -->

    <insert id="insert"
            parameterType="com.ledgerbase.backend.model.LedgerTransaction"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">

        INSERT INTO transactions (
            business_id,
            created_by,
            category_id,
            customer_id,
            vendor_id,
            description,
            transaction_date,
            status
        )
        VALUES (
            #{businessId},
            #{createdBy},
            #{categoryId},
            #{customerId},
            #{vendorId},
            #{description},
            #{transactionDate},
            'DRAFT'
        )

    </insert>


    <!-- ========================================================
         3. FIND ONE TRANSACTION BY BUSINESS AND ID
         ======================================================== -->

    <!--
        Retrieve one transaction belonging to a business.

        NEW:

        Join transaction_journal_numbers to retrieve the
        business-specific journal sequence.

        Aliases:

        t = transactions
        j = transaction_journal_numbers

        We use LEFT JOIN rather than INNER JOIN.

        This ensures a transaction remains retrievable
        even if its journal-number mapping is unexpectedly
        missing.

        In that situation, journalNumber will be null,
        making a data inconsistency easier to diagnose.

        The JOIN includes both business_id and transaction_id
        to preserve company isolation.

        The internal transaction ID remains unchanged.
    -->

    <select id="findById"
            resultMap="LedgerTransactionResultMap">

        SELECT
            t.id,
            t.business_id,
            j.journal_number,
            t.created_by,
            t.category_id,
            t.customer_id,
            t.vendor_id,
            t.description,
            t.transaction_date,
            t.status,
            t.created_at

        FROM transactions t

        LEFT JOIN transaction_journal_numbers j
            ON j.business_id = t.business_id
           AND j.transaction_id = t.id

        WHERE t.business_id = #{businessId}
          AND t.id = #{transactionId}

    </select>


    <!-- ========================================================
         4. FIND ALL TRANSACTIONS FOR ONE BUSINESS
         ======================================================== -->

    <!--
        Retrieve every transaction belonging to a business.

        NEW:

        Include journal_number in the returned results.

        Each transaction now contains the information
        required to display JE-0001, JE-0002, etc.

        ORDERING:

        1. Most recent accounting date first.
        2. Most recent creation timestamp first.
        3. Highest internal transaction ID first.

        We preserve the existing ordering behavior.

        The WHERE clause ensures that only transactions
        belonging to the requested business are returned.
    -->

    <select id="findByBusinessId"
            resultMap="LedgerTransactionResultMap">

        SELECT
            t.id,
            t.business_id,
            j.journal_number,
            t.created_by,
            t.category_id,
            t.customer_id,
            t.vendor_id,
            t.description,
            t.transaction_date,
            t.status,
            t.created_at

        FROM transactions t

        LEFT JOIN transaction_journal_numbers j
            ON j.business_id = t.business_id
           AND j.transaction_id = t.id

        WHERE t.business_id = #{businessId}

        ORDER BY
            t.transaction_date DESC,
            t.created_at DESC,
            t.id DESC

    </select>


    <!-- ========================================================
         5. POST A DRAFT TRANSACTION
         ========================================================

        Atomically transition a financial transaction
        from DRAFT to POSTED.

        The PostgreSQL update also records the posting
        timestamp using the database server's clock.

        This timestamp is distinct from transaction_date:

        - transaction_date: Accounting date of the journal.
        - posted_at: Actual time the journal was finalized.

        The status condition prevents posting the same
        transaction more than once.

        TransactionService performs this operation within
        an existing PostgreSQL transaction and acquires
        the transaction row lock beforehand.

        The posting timestamp is subsequently included
        in the TransactionPosted outbox event payload.
    -->

    <update id="markAsPosted">

        UPDATE transactions

        SET status = 'POSTED',
            posted_at = CURRENT_TIMESTAMP

        WHERE business_id = #{businessId}
        AND id = #{transactionId}
        AND status = 'DRAFT'

    </update>


    <!-- ========================================================
         6. RETRIEVE AND LOCK A TRANSACTION FOR POSTING
         ======================================================== -->

    <!--
        Retrieve a transaction while acquiring a PostgreSQL
        row-level lock.

        TransactionService calls this method inside an
        @Transactional service operation.

        SELECT ... FOR UPDATE prevents conflicting operations
        on the same transaction header until posting finishes.

        NEW:

        We join the journal-number mapping so the returned
        LedgerTransaction also contains journalNumber.

        IMPORTANT POSTGRESQL DETAIL:

        Because we use a LEFT JOIN, we explicitly write:

            FOR UPDATE OF t

        This locks only the transactions table alias "t".

        Without "OF t", PostgreSQL could attempt to lock
        the nullable side of the LEFT JOIN and reject
        the query.

        We do not need to lock the journal-number mapping:
        journal numbering is assigned at creation and should
        not change during posting.

        This preserves the transaction-header locking
        behavior required for safe posting.
    -->

    <select id="findByIdForUpdate"
            resultMap="LedgerTransactionResultMap">

        SELECT
            t.id,
            t.business_id,
            j.journal_number,
            t.created_by,
            t.category_id,
            t.customer_id,
            t.vendor_id,
            t.description,
            t.transaction_date,
            t.status,
            t.created_at

        FROM transactions t

        LEFT JOIN transaction_journal_numbers j
            ON j.business_id = t.business_id
           AND j.transaction_id = t.id

        WHERE t.business_id = #{businessId}
          AND t.id = #{transactionId}

        FOR UPDATE OF t

    </select>

</mapper>
