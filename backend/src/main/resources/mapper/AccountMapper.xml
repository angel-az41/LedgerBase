<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- ============================================================ -->
<!-- LEDGERBASE — ACCOUNT SQL MAPPER -->
<!-- ============================================================ -->

<!--
    Maps AccountMapper.java methods to PostgreSQL queries.

    Responsibilities:

    - Retrieve accounts
    - Retrieve calculated posted account balances
    - Retrieve individual accounts
    - Create accounts
    - Rename accounts
    - Deactivate accounts

    V7 ENHANCEMENTS:

    - Financial reporting classifications
    - Optional parent-child account hierarchy
    - Account posting eligibility

    IMPORTANT:

    Account balances are NOT stored in the accounts table.

    They are calculated from ledger_entries belonging
    to POSTED transactions.

    Non-postable grouping accounts cannot receive ledger
    entries because PostgreSQL enforces that restriction.

    All account queries must respect business isolation.
-->

<mapper namespace="com.ledgerbase.backend.mapper.AccountMapper">

    <!-- ======================================================== -->
    <!-- ACCOUNT RESULT MAPPING -->
    <!-- ======================================================== -->

    <!--
        Convert a PostgreSQL accounts row
        into a Java Account object.

        Existing mappings remain unchanged.

        V7 adds:

        reporting_group   -> reportingGroup
        parent_account_id -> parentAccountId
        is_postable       -> postable

        Note:

        is_active and is_postable have different meanings.

        is_active:
            Whether the account is active for normal use.

        is_postable:
            Whether the account may receive ledger entries.
    -->

    <resultMap
        id="accountResultMap"
        type="com.ledgerbase.backend.model.Account">

        <!-- ==================================================== -->
        <!-- ACCOUNT IDENTITY -->
        <!-- ==================================================== -->

        <id property="id" column="id"/>

        <result property="businessId" column="business_id"/>


        <!-- ==================================================== -->
        <!-- BASIC ACCOUNT INFORMATION -->
        <!-- ==================================================== -->

        <result property="code" column="code"/>

        <result property="name" column="name"/>

        <result property="accountType" column="account_type"/>


        <!-- ==================================================== -->
        <!-- V7 — REPORTING CLASSIFICATION -->
        <!-- ==================================================== -->

        <result
            property="reportingGroup"
            column="reporting_group"/>


        <!-- ==================================================== -->
        <!-- V7 — ACCOUNT HIERARCHY -->
        <!-- ==================================================== -->

        <result
            property="parentAccountId"
            column="parent_account_id"/>


        <!-- ==================================================== -->
        <!-- ACCOUNT STATUS -->
        <!-- ==================================================== -->

        <result property="active" column="is_active"/>

        <result property="postable" column="is_postable"/>


        <!-- ==================================================== -->
        <!-- AUDIT INFORMATION -->
        <!-- ==================================================== -->

        <result property="createdAt" column="created_at"/>

    </resultMap>


    <!-- ======================================================== -->
    <!-- ACCOUNT BALANCE RESULT MAPPING -->
    <!-- ======================================================== -->

    <!--
        Convert the calculated balance query result
        into a Java AccountBalance object.

        Monetary columns are PostgreSQL NUMERIC values.
        MyBatis maps these to Java BigDecimal.

        This result includes:

        - Account identification
        - Fundamental account type
        - Account active status
        - Total posted debits
        - Total posted credits
        - Calculated signed balance

        IMPORTANT:

        AccountBalance remains unchanged in this step.

        We do not aggregate parent and child balances here.
        Each account's balance is calculated from its own
        ledger entries only.

        This avoids double-counting financial activity.

        Non-postable grouping accounts have no ledger entries,
        so their direct posted balances are zero.

        Hierarchical subtotals, if needed for presentation,
        will be calculated separately.
    -->

    <resultMap
        id="accountBalanceResultMap"
        type="com.ledgerbase.backend.model.AccountBalance">

        <id property="id" column="id"/>

        <result property="businessId" column="business_id"/>

        <result property="code" column="code"/>

        <result property="name" column="name"/>

        <result property="accountType" column="account_type"/>

        <result property="active" column="is_active"/>

        <result
            property="postedDebits"
            column="posted_debits"
            javaType="java.math.BigDecimal"/>

        <result
            property="postedCredits"
            column="posted_credits"
            javaType="java.math.BigDecimal"/>

        <result
            property="balance"
            column="balance"
            javaType="java.math.BigDecimal"/>

    </resultMap>


    <!-- ======================================================== -->
    <!-- GET ALL ACCOUNTS FOR A BUSINESS -->
    <!-- ======================================================== -->

    <!--
        Retrieve every account belonging to the business.

        Includes:

        - Active accounts
        - Inactive accounts
        - Postable accounts
        - Non-postable grouping accounts

        V7 classification, hierarchy and posting fields
        are included in the result.
    -->

    <select
        id="findByBusinessId"
        resultMap="accountResultMap">

        SELECT
            id,
            business_id,
            code,
            name,
            account_type,

            reporting_group,
            parent_account_id,

            is_active,
            is_postable,

            created_at

        FROM accounts

        WHERE business_id = #{businessId}

        ORDER BY code, id

    </select>


    <!-- ======================================================== -->
    <!-- GET CALCULATED POSTED ACCOUNT BALANCES -->
    <!-- ======================================================== -->

    <!--
        Calculate financial balances for one business.

        This query follows double-entry accounting.

        STEP 1:
            Aggregate debits and credits for each account.

        STEP 2:
            Include only POSTED transactions.

        STEP 3:
            LEFT JOIN calculated totals with accounts.

        STEP 4:
            Return zero for accounts without posted entries.

        STEP 5:
            Calculate each account's signed balance
            according to its normal accounting direction.

        NORMAL DEBIT BALANCES:

            ASSET
            EXPENSE

        NORMAL CREDIT BALANCES:

            LIABILITY
            EQUITY
            REVENUE

        IMPORTANT:

        - DRAFT transactions are excluded.
        - Business isolation is maintained.
        - Inactive accounts remain visible.
        - PostgreSQL NUMERIC is used for money.
        - Grouping accounts do not accumulate child balances
          in this query.

        V7 intentionally does not change the existing
        balance calculation logic.
    -->

    <select
        id="findBalancesByBusinessId"
        resultMap="accountBalanceResultMap">

        WITH posted_totals AS (

            <!-- ================================================ -->
            <!-- STEP 1 — AGGREGATE POSTED LEDGER ENTRIES -->
            <!-- ================================================ -->

            SELECT
                le.business_id,
                le.account_id,

                SUM(le.debit) AS total_debits,

                SUM(le.credit) AS total_credits

            FROM ledger_entries le

            INNER JOIN transactions t
                ON t.business_id = le.business_id
               AND t.id = le.transaction_id

            WHERE le.business_id = #{businessId}
              AND t.status = 'POSTED'

            GROUP BY
                le.business_id,
                le.account_id
        )


        <!-- ==================================================== -->
        <!-- STEP 2 — RETURN ACCOUNT INFORMATION AND BALANCES -->
        <!-- ==================================================== -->

        SELECT
            a.id,
            a.business_id,
            a.code,
            a.name,
            a.account_type,
            a.is_active,


            <!-- ================================================ -->
            <!-- TOTAL POSTED DEBITS -->
            <!-- ================================================ -->

            COALESCE(
                pt.total_debits,
                0::NUMERIC
            ) AS posted_debits,


            <!-- ================================================ -->
            <!-- TOTAL POSTED CREDITS -->
            <!-- ================================================ -->

            COALESCE(
                pt.total_credits,
                0::NUMERIC
            ) AS posted_credits,


            <!-- ================================================ -->
            <!-- CALCULATE SIGNED ACCOUNT BALANCE -->
            <!-- ================================================ -->

            CASE

                <!-- Debit-normal account types. -->
                WHEN a.account_type IN ('ASSET', 'EXPENSE')
                THEN

                    COALESCE(pt.total_debits, 0::NUMERIC)
                    -
                    COALESCE(pt.total_credits, 0::NUMERIC)

                <!-- Credit-normal account types. -->
                ELSE

                    COALESCE(pt.total_credits, 0::NUMERIC)
                    -
                    COALESCE(pt.total_debits, 0::NUMERIC)

            END AS balance


        FROM accounts a


        <!-- ==================================================== -->
        <!-- KEEP ACCOUNTS WITHOUT POSTED ACTIVITY -->
        <!-- ==================================================== -->

        LEFT JOIN posted_totals pt
            ON pt.business_id = a.business_id
           AND pt.account_id = a.id


        <!-- ==================================================== -->
        <!-- BUSINESS ISOLATION -->
        <!-- ==================================================== -->

        WHERE a.business_id = #{businessId}

        ORDER BY a.code, a.id

    </select>


    <!-- ======================================================== -->
    <!-- GET ONE ACCOUNT -->
    <!-- ======================================================== -->

    <!--
        Retrieve one account belonging to the
        specified business.

        V7 adds reportingGroup, parentAccountId
        and postable to the returned Account object.
    -->

    <select
        id="findById"
        resultMap="accountResultMap">

        SELECT
            id,
            business_id,
            code,
            name,
            account_type,

            reporting_group,
            parent_account_id,

            is_active,
            is_postable,

            created_at

        FROM accounts

        WHERE business_id = #{businessId}
          AND id = #{accountId}

    </select>


    <!-- ======================================================== -->
    <!-- INSERT NEW ACCOUNT -->
    <!-- ======================================================== -->

    <!--
        Create a new account in PostgreSQL.

        Existing values:

        - business_id
        - code
        - name
        - account_type

        V7 values:

        - reporting_group
        - parent_account_id
        - is_postable

        PostgreSQL generates:

        - id
        - is_active (defaults to TRUE)
        - created_at

        COMPATIBILITY:

        Existing AccountService calls may not yet assign
        reportingGroup, parentAccountId or postable.

        NULL reportingGroup:
            Account remains unclassified.

        NULL parentAccountId:
            Account is a top-level account.

        NULL postable:
            COALESCE treats the account as postable.

        This maintains the original account creation
        behavior until the Java service and API are
        updated for V7.

        PostgreSQL constraints and triggers validate
        the new fields regardless of the caller.
    -->

    <insert
        id="insert"
        parameterType="com.ledgerbase.backend.model.Account"
        useGeneratedKeys="true"
        keyProperty="id"
        keyColumn="id">

        INSERT INTO accounts (
            business_id,
            code,
            name,
            account_type,

            reporting_group,
            parent_account_id,
            is_postable
        )

        VALUES (
            #{businessId},
            #{code},
            #{name},
            #{accountType},

            #{reportingGroup,jdbcType=VARCHAR},
            #{parentAccountId,jdbcType=BIGINT},

            COALESCE(
                #{postable,jdbcType=BOOLEAN},
                TRUE
            )
        )

    </insert>

    <!-- ======================================================== -->
    <!-- UPDATE ACCOUNT REPORTING GROUP -->
    <!-- ======================================================== -->

    <!--
        Update the financial reporting classification
        of an existing account.

        Examples:

        ASSET -> CURRENT_ASSET

        LIABILITY -> NON_CURRENT_LIABILITY

        EXPENSE -> OPERATING_EXPENSE

        IMPORTANT:

        - Only reporting_group is modified.
        - Business isolation is enforced in the WHERE clause.
        - Inactive accounts may still be classified.
        - Account identity and ledger history are preserved.
        - PostgreSQL validates group/type compatibility.

        MyBatis returns the number of updated rows:

        1 = Matching account found and updated.
        0 = No matching account in this business.
    -->

    <update id="updateReportingGroup">

        UPDATE accounts

        SET reporting_group = #{reportingGroup}

        WHERE business_id = #{businessId}
          AND id = #{accountId}

    </update>

    <!-- ======================================================== -->
    <!-- UPDATE ACCOUNT NAME -->
    <!-- ======================================================== -->

    <!--
        Existing account rename query.

        Only active accounts may be renamed.

        Account codes and fundamental account types
        remain unchanged.

        V7 reporting classifications and hierarchy
        are not modified by this operation.

        Those changes will have separate, validated
        service methods and mapper statements.
    -->

    <update id="updateName">

        UPDATE accounts

        SET name = #{name}

        WHERE business_id = #{businessId}
          AND id = #{accountId}
          AND is_active = TRUE

    </update>


    <!-- ======================================================== -->
    <!-- DEACTIVATE ACCOUNT -->
    <!-- ======================================================== -->

    <!--
        Existing account deactivation query.

        Accounts are preserved rather than deleted.

        Posted journal entries may still reference
        an inactive account.

        IMPORTANT:

        Deactivation changes is_active.

        It does NOT change is_postable.

        These are separate accounting concepts.
    -->

    <update id="deactivate">

        UPDATE accounts

        SET is_active = FALSE

        WHERE business_id = #{businessId}
          AND id = #{accountId}
          AND is_active = TRUE

    </update>

</mapper>
