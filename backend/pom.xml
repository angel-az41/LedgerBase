<?xml version="1.0" encoding="UTF-8"?>

<!--
    ==========================================
    LedgerBase - Maven Project Configuration
    ==========================================

    pom.xml (Project Object Model) defines:
    1. Project information
    2. Java and Spring Boot versions
    3. External libraries (dependencies)
    4. Build tools and plugins

    Maven uses this file to download dependencies,
    compile Java code, run tests, and package the app.
-->

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot Parent:
        Provides compatible dependency versions,
        Maven plugin configuration, and build defaults.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <!--
        Project Information:
        Identifies our backend application to Maven.
    -->
    <groupId>com.ledgerbase</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>LedgerBase Backend</name>
    <description>
        Financial Management and Audit Platform
    </description>

    <!--
        Java Version:
        Compile LedgerBase using Java 25.
    -->
    <properties>
        <java.version>25</java.version>
    </properties>

    <!-- ======================================
         APPLICATION DEPENDENCIES
         ====================================== -->

    <dependencies>

        <!--
            Spring Web MVC:
            Build REST APIs using Java controllers.

            Example:
            GET /api/v1/accounts
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!--
            Spring Validation:
            Validate user inputs sent to our APIs.

            Examples:
            @NotNull, @NotBlank, @Positive
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Spring Security Crypto:
            Provides secure password hashing and verification.

            BCrypt uses a random salt and a configurable
            work factor to resist offline password attacks.

            IMPORTANT:

            We are adding only the cryptography module
            at this stage, not the complete Spring Security
            web authentication starter.

            This allows us to implement and test password
            handling without changing existing API access.

            Maven uses the dependency version managed by
            the Spring Boot parent.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ==================================
             JWT SUPPORT
             ================================== -->

        <!--
            Spring Security OAuth2 JOSE:
            Provides JWT signing, decoding, and validation.

            NimbusJwtEncoder:
            Creates cryptographically signed JWTs.

            NimbusJwtDecoder:
            Verifies JWT signatures and token claims.

            We are deliberately not adding the full
            Spring Security web starter yet.

            This lets us test token functionality
            independently of HTTP authorization.

            Dependency version is managed by the
            Spring Boot parent.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!--
            Spring Boot Actuator:
            Expose application health and monitoring data.

            Example:
            GET /actuator/health
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            MyBatis:
            Execute SQL queries and map database
            results to Java objects.

            We will use Mapper interfaces and SQL
            statements for CRUD and financial reporting.
        -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>4.0.1</version>
        </dependency>

        <!--
            PostgreSQL JDBC Driver:
            Allows Spring Boot and MyBatis
            to communicate with PostgreSQL.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Flyway:
            Manage database schema changes using
            version-controlled SQL migration files.

            Example:
            V1__create_core_tables.sql
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!--
            Flyway PostgreSQL Support:
            Adds PostgreSQL-specific database support
            for running Flyway migrations.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
            Spring Boot DevTools:
            Automatically restarts the backend
            when application classes change.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ==================================
             HTTP AUTHENTICATION
             ================================== -->

        <!--
            Spring Security OAuth2 Resource Server:

            Integrates JWT Bearer authentication
            with Spring Security's HTTP filter chain.

            The resource server will use our existing
            JwtDecoder bean to verify incoming tokens.

            This starter also includes the core
            Spring Security infrastructure.

            Version management is provided by
            the Spring Boot parent.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ==================================
             EXCEL IMPORT AND EXPORT
             ================================== -->

        <!--
            Apache POI:
            Read and write Microsoft Excel .xlsx files.

            Milestone 20 uses this library to:

            1. Export the Chart of Accounts to Excel.
            2. Generate downloadable import templates.
            3. Read uploaded Excel spreadsheets.
            4. Support future journal entry and
               financial report import/export.

            The poi-ooxml dependency includes the
            core POI libraries required for .xlsx.
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <!-- ==================================
             CSV IMPORT PROCESSING
             ================================== -->

        <!--
            Apache Commons CSV:
            Parse uploaded CSV files safely.

            Unlike String.split(","), this library
            correctly handles:

            1. Commas inside quoted account names.
            2. Escaped quotation marks.
            3. Multiline CSV fields.
            4. CSV files exported by LedgerBase.

            CSV records will be converted into
            AccountImportRow objects.

            This dependency is for CSV parsing;
            Apache POI remains responsible for XLSX.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.14.1</version>
        </dependency>

        <!-- ==================================
             TESTING DEPENDENCIES
             ================================== -->

        <!--
            Spring Web MVC Testing:
            Test REST controllers and HTTP responses.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Validation Testing:
            Test validation rules and invalid inputs.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Actuator Testing:
            Test application health and monitoring
            functionality.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            MyBatis Testing:
            Test SQL mappers and database operations.
        -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter-test</artifactId>
            <version>4.0.1</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ======================================
         BUILD CONFIGURATION
         ====================================== -->

    <build>
        <plugins>

            <!--
                Spring Boot Maven Plugin:
                Packages the application into an
                executable JAR and allows us to run:

                ./mvnw spring-boot:run
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
