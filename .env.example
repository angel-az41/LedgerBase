# ============================================================
# LEDGERBASE — LOCAL ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================================

# This file documents the environment variables required
# to run LedgerBase locally.
#
# SETUP:
#
# 1. Copy this file to .env
# 2. Replace the example password with your own password
# 3. Start PostgreSQL using Docker Compose
#
# IMPORTANT:
#
# - Never put a real password in this example file.
# - Never commit your private .env file.
# - This file is intended to be committed to GitHub.

# ============================================================
# POSTGRESQL DATABASE PASSWORD
# ============================================================

# Password used by the local PostgreSQL Docker container.
#
# Choose a strong password for your own development setup.
#
# This is an example placeholder, not a production password.

POSTGRES_PASSWORD=replace-with-your-own-strong-password

# ============================================================
# JWT ACCESS TOKEN SIGNING
# ============================================================

# Base64-encoded random signing key for HS256 JWTs.
#
# Generate a secure key using:
#
# openssl rand -base64 32
#
# Copy the generated value into your private .env file.
#
# Never use this placeholder as an actual signing key.
# Never commit real JWT secrets to Git.

JWT_SECRET_BASE64=replace-with-your-generated-base64-secret
