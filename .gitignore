
# ==========================================
# LedgerBase - Git Ignore
# ==========================================

# Local environment variables and secrets
.env
.env.*
!.env.example

# Java / Maven build output
target/
*.class

# Node.js / Vue dependencies
node_modules/
dist/

# IDE configuration
.idea/
.vscode/

# macOS system files
.DS_Store

# Log files
*.log

# Local infrastructure credentials
.secrets/

# LedgerBase performance benchmark execution artifacts
/benchmarks/results/*
!/benchmarks/results/.gitkeep

# Python-generated files
__pycache__/
*.pyc

# Local benchmark results and dataset progress
/benchmarks/results/*
!/benchmarks/results/.gitkeep