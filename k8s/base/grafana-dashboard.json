        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ledgerbase-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"accounting-core|reporting-service|gateway\",uri!~\"/actuator/.*\",status=~\"5..\"}[5m])) or on (job) (0 * up{job=~\"accounting-core|reporting-service|gateway\"})",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Mean HTTP response time",
      "description": "Mean request duration (not p95/p99). Averages exclude Actuator requests.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerbase-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ledgerbase-prometheus"
          },
          "editorMode": "code",
          "expr": "1000 * sum by (job) (rate(http_server_requests_seconds_sum{job=~\"accounting-core|reporting-service|gateway\",uri!~\"/actuator/.*\"}[5m])) / clamp_min(sum by (job) (rate(http_server_requests_seconds_count{job=~\"accounting-core|reporting-service|gateway\",uri!~\"/actuator/.*\"}[5m])), 0.000001)",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
