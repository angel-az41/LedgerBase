    {
      "id": 4,
      "title": "Application requests / second",
      "description": "Per-service HTTP traffic, excluding Actuator endpoints. Requires at least two samples within five minutes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerbase-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ledgerbase-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"accounting-core|reporting-service|gateway\",uri!~\"/actuator/.*\"}[5m]))",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP 5xx errors / second",
      "description": "Server error rate. Zero when no 5xx series is present; exclude Actuator endpoints.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerbase-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
